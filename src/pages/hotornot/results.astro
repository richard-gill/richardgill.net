---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { hotdogImages } from '../../data/hotdogImages.js';

const images = hotdogImages
	.filter((img) => img.file !== 'wherenext.webp')
	.map(({ file, title }) => ({ file, title }));
---

<BaseLayout
	title="Hot or Not Dog Results"
	description="See which hot dogs from Richard Gill's Hot Dog World Tour people voted hot, and which they voted not."
>
	<script type="application/json" id="results-data" set:html={JSON.stringify(images)}></script>

	<header class="text-center mb-6">
		<h1 class="text-3xl font-bold mb-1">🔥 Hot or Not Dog Results ❄️</h1>
		<p class="text-gray-400">What everyone thinks of each hot dog, hottest first.</p>
	</header>

	<main class="max-w-xl mx-auto mb-8">
		<div id="results" class="space-y-2"></div>
	</main>

	<div class="text-center space-x-4">
		<a href="/hotornot" class="text-red-400 text-sm no-underline hover:underline">🔥 Vote</a>
		<a href="/" class="text-red-400 text-sm no-underline hover:underline">← Gallery</a>
	</div>

	<script>
		import { renderResults } from '../../scripts/hotornot.js';

		const images = JSON.parse(document.getElementById('results-data').textContent);
		renderResults(document.getElementById('results'), images);
	</script>
</BaseLayout>
