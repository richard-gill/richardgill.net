---
// One section's list of Daily Wiener stories: picture, headline, summary, source and date.
interface Article {
	title: string;
	link: string;
	source: string;
	summary: string;
	image: string;
	date: string | null;
}
interface Props {
	articles: Article[];
	/** Load the first few images straight away (top of the page). */
	eagerCount?: number;
}

const { articles, eagerCount = 0 } = Astro.props;
const fmtDate = (iso: string) =>
	new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/London', day: 'numeric', month: 'short', year: 'numeric' }).format(new Date(iso));
---

<ol class="divide-y divide-gray-800">
	{articles.map((a, i) => (
		<li>
			<a href={a.link} target="_blank" rel="noopener noreferrer" class="group flex gap-3 sm:gap-4 py-4 no-underline text-white">
				<span class="relative shrink-0 w-24 h-24 sm:w-40 sm:h-[90px] rounded-lg overflow-hidden bg-[#2a2a2a]">
					<span class="absolute inset-0 flex items-center justify-center text-3xl" aria-hidden="true">🌭</span>
					{a.image && (
						<img
							src={a.image}
							alt=""
							loading={i < eagerCount ? 'eager' : 'lazy'}
							decoding="async"
							referrerpolicy="no-referrer"
							width="480"
							height="270"
							class="relative w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
							onerror="this.remove()"
						/>
					)}
					<span class="absolute top-1 left-1 bg-black/70 text-red-400 font-black text-xs rounded px-1.5 py-0.5 tabular-nums">{i + 1}</span>
				</span>
				<span class="min-w-0">
					<span class="block font-semibold leading-snug group-hover:text-red-400 group-hover:underline">
						{a.title}
						<span class="sr-only">(opens in a new tab)</span>
					</span>
					{a.summary && <span class="hidden sm:block text-sm text-gray-400 mt-1 line-clamp-2">{a.summary}</span>}
					<span class="block text-sm text-gray-500 mt-1">
						{a.source}
						{a.source && a.date && ' · '}
						{a.date && <time datetime={a.date}>{fmtDate(a.date)}</time>}
					</span>
				</span>
			</a>
		</li>
	))}
</ol>
