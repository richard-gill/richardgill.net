---
import '../styles/global.css';
import { hotdogsBought } from '../data/hotdogsBought.js';

interface Props {
	title: string;
	description?: string;
	/** Show the small Hot Dog World Tour logo (linking home) at the top of the page. */
	logo?: boolean;
}

const { title, description = 'Richard Gill\'s Hot Dog World Tour', logo = true } = Astro.props;
const year = new Date().getFullYear();

// PayPal.Me "Buy me a hot dog" tiers. The amount (with GBP currency) is appended to pre-fill the payment.
const paypalMeBase = 'https://www.paypal.com/paypalme/GillyTheGreat';
const hotdogTiers = [
	{ key: 'bronze', name: 'Bronze', price: '£5', amount: '5', topping: 'with ketchup', medal: '🥉', classes: 'border-amber-700 hover:bg-amber-700/20' },
	{ key: 'silver', name: 'Silver', price: '£7.50', amount: '7.50', topping: 'with onions', medal: '🥈', classes: 'border-gray-300 hover:bg-gray-300/15' },
	{ key: 'gold', name: 'Gold', price: '£9', amount: '9', topping: 'with all the toppings', medal: '🥇', classes: 'border-yellow-400 hover:bg-yellow-400/15' },
];
const boughtCount = (key: string) => Math.max(0, Math.floor(Number(hotdogsBought[key]) || 0));
const totalBought = hotdogTiers.reduce((sum, t) => sum + boughtCount(t.key), 0);
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<title>{title}</title>
		<meta http-equiv="content-language" content="en-GB" />

		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

		<!-- Preload LCP images -->
		<link rel="preload" href="/images/thumbs/amsterdam.webp" as="image" type="image/webp" fetchpriority="high" />
		<link rel="preload" href="/images/thumbs/krakow.webp" as="image" type="image/webp" fetchpriority="high" />
		<link rel="preload" href="/images/thumbs/Milan.webp" as="image" type="image/webp" fetchpriority="high" />

		<slot name="head" />
	</head>
	<body class="bg-[#1a1a1a] text-white p-8 md:p-8">
		{logo && (
			<a href="/" class="block w-fit mx-auto mb-4 transition-transform hover:scale-105" aria-label="Hot Dog World Tour home">
				<img
					src="/images/thumbs/sm/hotdoglogo.webp"
					alt="Hot Dog World Tour"
					width="404"
					height="352"
					class="w-[90px] h-auto"
				/>
			</a>
		)}
		<slot />

		<footer class="text-center mt-8 pt-4 border-t border-gray-700">
			<p class="text-lg font-semibold mb-1">🌭 Buy me a hot dog</p>
			<p class="text-sm text-gray-300 max-w-[26rem] mx-auto mb-1">
				Buy me a hot dog and I'll credit you in the photo's description when I eat it! Add your name in the PayPal note.
			</p>
			<p class="text-sm text-gray-400 mb-3">
				{totalBought > 0 ? (
					<>
						<strong class="text-red-400 text-base">{totalBought}</strong>
						{totalBought === 1 ? ' hot dog bought by a fan so far. Thank you!' : ' hot dogs bought by fans so far. Thank you!'}
					</>
				) : (
					'Be the first to buy me a hot dog!'
				)}
			</p>
			<div class="grid grid-cols-3 gap-2 sm:gap-3 max-w-[26rem] mx-auto mb-4">
				{hotdogTiers.map((tier) => (
					<a
						href={`${paypalMeBase}/${tier.amount}GBP`}
						target="_blank"
						rel="noopener noreferrer"
						class={`flex flex-col items-center min-w-0 px-1.5 py-2 sm:px-3 sm:py-3 rounded-xl border-2 text-white text-center no-underline transition-colors ${tier.classes}`}
					>
						<span class="text-xl sm:text-2xl" aria-hidden="true">{tier.medal}</span>
						<span class="text-sm sm:text-base font-bold">{tier.name}</span>
						<span class="text-lg sm:text-xl font-semibold">{tier.price}</span>
						<span class="text-[0.7rem] sm:text-xs leading-tight text-gray-400">{tier.topping}</span>
						{boughtCount(tier.key) > 0 && (
							<span class="mt-1 text-[0.7rem] sm:text-xs font-semibold text-gray-300">
								🌭 × {boughtCount(tier.key)}
							</span>
						)}
					</a>
				))}
			</div>
			<p class="text-gray-400 text-sm leading-relaxed">
				richardgill.net &copy; {year}
			</p>
		</footer>
	</body>
</html>
