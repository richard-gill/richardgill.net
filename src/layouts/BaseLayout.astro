---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	/** Show the small Hot Dog World Tour logo (linking home) at the top of the page. */
	logo?: boolean;
}

const { title, description = 'Richard Gill\'s Hot Dog World Tour', logo = true } = Astro.props;
const year = new Date().getFullYear();

// PayPal.Me "Buy me a hot dog" tiers. The amount (with GBP currency) is appended to pre-fill the payment.
const paypalMeBase = 'https://www.paypal.com/paypalme/GillyTheGreat';
const hotdogTiers = [
	{ name: 'Bronze', price: '£5', amount: '5', topping: 'with ketchup', medal: '🥉', classes: 'border-amber-700 hover:bg-amber-700/20' },
	{ name: 'Silver', price: '£7.50', amount: '7.50', topping: 'with onions', medal: '🥈', classes: 'border-gray-300 hover:bg-gray-300/15' },
	{ name: 'Gold', price: '£9', amount: '9', topping: 'with all the toppings', medal: '🥇', classes: 'border-yellow-400 hover:bg-yellow-400/15' },
];
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<title>{title}</title>
		<meta http-equiv="content-language" content="en-GB" />

		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

		<!-- Preload LCP images -->
		<link rel="preload" href="/images/thumbs/amsterdam.webp" as="image" type="image/webp" fetchpriority="high" />
		<link rel="preload" href="/images/thumbs/krakow.webp" as="image" type="image/webp" fetchpriority="high" />
		<link rel="preload" href="/images/thumbs/Milan.webp" as="image" type="image/webp" fetchpriority="high" />

		<slot name="head" />
	</head>
	<body class="bg-[#1a1a1a] text-white p-8 md:p-8">
		{logo && (
			<a href="/" class="block w-fit mx-auto mb-4 transition-transform hover:scale-105" aria-label="Hot Dog World Tour home">
				<img
					src="/images/thumbs/sm/hotdoglogo.webp"
					alt="Hot Dog World Tour"
					width="404"
					height="352"
					class="w-[90px] h-auto"
				/>
			</a>
		)}
		<slot />

		<footer class="text-center mt-8 pt-4 border-t border-gray-700">
			<p class="text-lg font-semibold mb-3">🌭 Buy me a hot dog</p>
			<div class="flex flex-wrap justify-center gap-3 mb-4">
				{hotdogTiers.map((tier) => (
					<a
						href={`${paypalMeBase}/${tier.amount}GBP`}
						target="_blank"
						rel="noopener noreferrer"
						class={`flex flex-col items-center w-32 px-3 py-3 rounded-xl border-2 text-white no-underline transition-colors ${tier.classes}`}
					>
						<span class="text-2xl" aria-hidden="true">{tier.medal}</span>
						<span class="font-bold">{tier.name}</span>
						<span class="text-xl font-semibold">{tier.price}</span>
						<span class="text-xs text-gray-400">{tier.topping}</span>
					</a>
				))}
			</div>
			<p class="text-gray-400 text-sm leading-relaxed">
				richardgill.net &copy; {year}
			</p>
		</footer>
	</body>
</html>
