---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Richard Gill\'s Hot Dog World Tour' } = Astro.props;
const year = new Date().getFullYear();

// PayPal.Me link for "Buy me a hot dog". Replace YOUR_PAYPAL_ME_NAME with your PayPal.Me username.
// The trailing amount pre-fills the payment (in your account's default currency); remove it to let people choose.
const paypalMeUrl = 'https://www.paypal.com/paypalme/GillyTheGreat/5';
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<title>{title}</title>
		<meta http-equiv="content-language" content="en-GB" />

		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

		<!-- Preload LCP images -->
		<link rel="preload" href="/images/thumbs/amsterdam.webp" as="image" type="image/webp" fetchpriority="high" />
		<link rel="preload" href="/images/thumbs/krakow.webp" as="image" type="image/webp" fetchpriority="high" />
		<link rel="preload" href="/images/thumbs/Milan.webp" as="image" type="image/webp" fetchpriority="high" />

		<slot name="head" />
	</head>
	<body class="bg-[#1a1a1a] text-white p-8 md:p-8">
		<slot />

		<footer class="text-center mt-8 pt-4 border-t border-gray-700">
			<a
				href={paypalMeUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-2 mb-4 px-5 py-2 rounded-full bg-red-500 text-white font-semibold no-underline transition-colors hover:bg-red-600"
			>
				🌭 Buy me a hot dog
			</a>
			<p class="text-gray-400 text-sm leading-relaxed">
				richardgill.net &copy; {year}
			</p>
		</footer>
	</body>
</html>
